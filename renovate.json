{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Group non-major GitHub Actions updates",
      "matchDepTypes": [
        "action"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "github-actions",
      "pinDigests": true
    },
    {
      "description": "Pin GitHub Actions digests on majors too",
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": true
    }
  ]
}
